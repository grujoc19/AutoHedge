# Market research: validated OpenAI/Ollama calls; optional read-only Exa collection
OPENAI_API_KEY=
EXA_API_KEY=

# Optional future cloud-provider credentials (adapters are not implemented yet).
# Only the selected cloud backend needs its key. Ollama profiles need none.
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
DEEPSEEK_API_KEY=
# GOOGLE_API_KEY is accepted as a fallback alias for GEMINI_API_KEY.

# Optional: Jupiter read-only token search and price lookup tools
JUPITER_API_KEY=

# Optional: CoinGecko Pro Onchain OHLCV (not attached to agents).
# Requires a subscription with token OHLCV/history access; leave empty if unused.
COINGECKO_PRO_API_KEY=

# Optional: Massive market data (API tools are not wired into agents)
MASSIVE_API_KEY=

# Live trading is NOT integrated with the default AutoHedge workflow.
# Never use a funded/main wallet while developing.
# Signing tools read SOLANA_PRIVATE_KEY, not WALLET_PRIVATE_KEY.
# Leave empty for research; integrated paper trading is not yet implemented.
SOLANA_PRIVATE_KEY=


# Optional research settings (defaults shown; live execution cannot be enabled here)
AUTOHEDGE_MODEL=gpt-4.1
AUTOHEDGE_SENTIMENT_MODEL=gpt-4o-mini
AUTOHEDGE_SEARCH_ENABLED=true
AUTOHEDGE_REQUEST_TIMEOUT=30
AUTOHEDGE_CYCLE_TIMEOUT=180
AUTOHEDGE_LOG_LEVEL=INFO
# AUTOHEDGE_LOG_FILE=agent_workspace/autohedge.log
# AUTOHEDGE_OPENAI_BASE_URL=https://api.openai.com/v1
# AUTOHEDGE_OLLAMA_BASE_URL=http://127.0.0.1:11434
# AUTOHEDGE_EXA_BASE_URL=https://api.exa.ai
# AUTOHEDGE_JUPITER_BASE_URL=https://api.jup.ag
# AUTOHEDGE_COINGECKO_BASE_URL=https://pro-api.coingecko.com/api/v3
# MASSIVE_BASE_URL=https://api.massive.com
# Cloud bindings may use AUTOHEDGE_OPENAI_API_KEY as an alias for OPENAI_API_KEY.

# Role profiles (G1.2). All lines below are examples, intentionally commented.
# OpenAI and Ollama profiles work for active research roles. Other active backends
# remain rejected until their adapters exist; no automatic provider fallback.
# See docs/MODEL_CONFIGURATION.md before enabling any profile.
# Fully local setup: configure all four active roles and disable optional Exa.
# See docs/OLLAMA_RESEARCH.md; no server/model is installed automatically.
# A profile requires MODEL. PROVIDER defaults to openai; supported values:
# openai, anthropic, gemini, deepseek, ollama.
# MAX_OUTPUT_TOKENS defaults to 1500; TIMEOUT inherits AUTOHEDGE_REQUEST_TIMEOUT.
# AUTOHEDGE_NEWS_INTELLIGENCE_PROVIDER=ollama
# AUTOHEDGE_NEWS_INTELLIGENCE_MODEL=your-local-news-model
# AUTOHEDGE_NEWS_INTELLIGENCE_MAX_OUTPUT_TOKENS=800
# AUTOHEDGE_NEWS_INTELLIGENCE_TIMEOUT=20
# AUTOHEDGE_MARKET_ANOMALY_PROVIDER=ollama
# AUTOHEDGE_MARKET_ANOMALY_MODEL=your-local-interpretation-model
# AUTOHEDGE_ON_CHAIN_INTELLIGENCE_PROVIDER=ollama
# AUTOHEDGE_ON_CHAIN_INTELLIGENCE_MODEL=optional-local-interpretation-model
# Python on-chain pattern detection does not require an LLM call.
# AUTOHEDGE_QUANT_PROVIDER=openai
# AUTOHEDGE_QUANT_MODEL=gpt-4.1
# AUTOHEDGE_TRADING_DIRECTOR_PROVIDER=openai
# AUTOHEDGE_TRADING_DIRECTOR_MODEL=gpt-4.1
# AUTOHEDGE_RISK_MANAGER_PROVIDER=ollama
# AUTOHEDGE_RISK_MANAGER_MODEL=your-local-risk-model
